# Copie para .env (o scripts\instalar.ps1 faz isso). NUNCA envie o .env ao GitHub.
# Os comentários ficam em linhas separadas: o painel lê cada linha como CHAVE=valor.

# Chave da API da NVIDIA: coloque pelo painel (Configurações > Chave da NVIDIA), não aqui.
NVIDIA_API_KEY=

# API local do Hermes (só 127.0.0.1). A chave é gerada por scripts\sync_env.py.
API_SERVER_ENABLED=true
API_SERVER_HOST=127.0.0.1
API_SERVER_PORT=8642
API_SERVER_KEY=

# Chave de API do Jellyfin (criada na instalação, usada para listar quem está assistindo e atualizar a biblioteca).
JELLYFIN_API_KEY=

# 1 = o Hermes conversa com o modelo falso (scripts\modelo_falso.py), para testar sem gastar a API. Em produção: 0 ou apagado.
ALICIA_MODO_TESTE=0